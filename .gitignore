# Python / venv
.venv/
__pycache__/
*.pyc

# 輸出（大檔，不進版控；output 已 symlink 到外接碟）
/output
/logs/

# 衍生資料庫（由 sidecar 重建）
catalog/*.db
# 衍生索引／一次性遷移產物（可由 sidecar 重建，不必進版控）
/catalog/index.csv
/publish/index.csv
/catalog/migrate_layout_*.json

# 素材（AI 生成的大檔）：整個 assets/ 不進版控
# 可追溯的紀錄不放這裡——音樂在 catalog/tracks.jsonl（append-only 事件流，含 prompt/seed/params/QC），
# 圖片在 assets/visuals/<kind><NN>/manifest.json（本機檔）。git 只收 catalog/ 與程式。
/assets/

# 模型權重
models/*
!models/README.md

# 實驗／一次性腳本（本地保留、不進版控）
/scratch/

# DistroKid 偵察輸出：內含 CSRF token、albumuuid、S3 上傳 policy/signature 等短效憑證
/browser/distrokid-recon-*.json

# YouTube OAuth 憑證 / token（機密）
.secrets/

# macOS
.DS_Store

# 本機 agent 設定（MCP server 設定、安裝的技能；純本機、不進版控）
/opencode.json
/.opencode/
/.agents/
/skills-lock.json
